# Build on the Spark: docker build -f scripts/Dockerfile.spark -t fsop-spark .
FROM nvcr.io/nvidia/pytorch:25.12-py3
RUN apt-get update && apt-get install -y --no-install-recommends \
    libegl1 libgl1 libgles2 libgl1-mesa-dri libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
# Preserve NVIDIA's Blackwell-compatible torch/torchvision builds.
RUN pip install shapely==2.2.0 omegaconf==2.4.0 typer==0.28.0 polars==2.1.0 \
    zarr==3.4.2 rerun-sdk==0.42.0 onnxruntime==1.31.1 onnx2torch==1.5.15 \
    panda3d==1.10.14 opencv-python-headless==4.11.0.86 pycocotools==2.0.10 \
    nvidia-ml-py==13.590.44 psutil==7.1.3 pytest==8.1.1 ruff==0.17.4
WORKDIR /workspace/fs-openpilot
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install -e . --no-deps
ENV OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 PYTHONUNBUFFERED=1 NVIDIA_DRIVER_CAPABILITIES=all
